* text=auto
*.cs text eol=lf
*.csproj text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.md text eol=lf
*.json text eol=lf
*.shader text eol=lf
*.svg text eol=lf
*.png binary
# Unity serializes empty YAML fields with a space after the colon.
*.meta text whitespace=-blank-at-eol
*.asset text whitespace=-blank-at-eol
